---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'Engine Simulator — 直列3〜12気筒 エンジン音シミュレーター' } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="直列3気筒から直列12気筒までのエンジン音をWeb Audioでリアルタイム合成するシミュレーター。Astro + Cloudflare Workers。"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
